# ==============================================================================
# WO&MAN — Environment Configuration
# ==============================================================================

# Application Security
SECRET_KEY=wo-and-man-luxury-secret-key-2026-prod-grade
FLASK_DEBUG=false
PORT=5000

# Database: SQLite (default) or PostgreSQL (e.g. postgresql://user:pass@localhost:5432/wo_and_man)
DATABASE_URL=sqlite:///instance/wo_and_man.db

# Business Timezone
TIMEZONE=Asia/Tashkent

# Booking Policy
MIN_BOOKING_NOTICE_HOURS=2
MAX_BOOKING_ADVANCE_DAYS=30
APPOINTMENT_BUFFER_MINUTES=10
MANUAL_APPROVAL_REQUIRED=false

# Telegram Bot Integration
# Official studio bot token obtained from @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_ADMIN=

# Independent Chat IDs for the 5 Professionals (can also be set in Admin Dashboard)
TELEGRAM_CHAT_ID_AZIZ=
TELEGRAM_CHAT_ID_KAMILA=
TELEGRAM_CHAT_ID_JAMSHID=
TELEGRAM_CHAT_ID_MADINA=
TELEGRAM_CHAT_ID_SHAVKAT=

# SMS Gateway Configuration (mock, eskiz, playmobile, twilio)
